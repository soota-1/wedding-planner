{
  "expo": {
    "name": "Wedding Tracker",
    "slug": "wedding-tracker",
    "scheme": "wedding-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F4"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F7F4"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "largeIcon": "./assets/images/icon.png",
          "color": "#9E5A47",
          "defaultChannel": "wedding-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Wedding Tracker mengakses galeri foto untuk menambahkan inspirasi moodboard."
        }
      ],
      "expo-sharing"
    ]
  }
}
